config_version=5

[application]
config/name="Knight Chess"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1180
window/size/viewport_height=900
window/size/window_width_override=1180
window/size/window_height_override=900
window/size/min_width=600
window/size/min_height=760
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)
